# ── 模型与翻译配置 ──────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key
# 唯一受信任的 OpenAI-compatible 模型端点；请求端点必须留空或与其一致，禁止重定向
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSLATE_API_KEY=
DEEPL_API_KEY=

# 字幕编辑 Agent 模型与 Token 预算（需支持 SSE 和 function tools）
TRANSLATION_AGENT_MODEL=sol
# OpenAI 推理强度：off（不覆盖上游默认值）/ minimal / low / medium / high / xhigh
# 开启前请选择支持 reasoning_effort 和工具调用的模型；不同模型支持的档位不同
TRANSLATION_REASONING_EFFORT=off
# 团队模式独立配置：主 Agent 规划/验收用 high，子 Agent 翻译用 medium
# 留空则继承上面的 TRANSLATION_REASONING_EFFORT；旧任务不受新配置影响
TRANSLATION_MAIN_REASONING_EFFORT=high
TRANSLATION_SUBAGENT_REASONING_EFFORT=medium
TRANSLATION_CONTEXT_TOKENS=128000
# 推理开启后，此上限同时包含隐藏推理 Token 和可见输出 Token
TRANSLATION_OUTPUT_TOKENS=16384
# 主/子 Agent 共享的每任务累计请求上限：默认 0 关闭限制，1～1000 启用上限
# 仍记录实际调用次数；关闭限制可能增加 API 费用，不影响 Token 上限和单次超时
TRANSLATION_REQUEST_BUDGET=0
# 主/子 Agent 共享的每轮累计 Token 预算：默认 2000 万，0 关闭
# 耗尽保留草稿；用户重新开启翻译后预算重置并续翻，自动重试/重启服务不重置
TRANSLATION_TOKEN_BUDGET=20000000

# Whisper 转写配置
# 唯一受信任的 Whisper 端点；扩展传入的地址必须与其一致。服务端密钥只发往其所属服务商：
# WHISPER_API_KEY → 本端点；GROQ_API_KEY → 仅 api.groq.com；OPENAI_API_KEY → 仅 OPENAI_BASE_URL
WHISPER_API_KEY=your-api-key
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3
GROQ_API_KEY=

# ── 服务端网络与持久化配置 ──────────────────────────────────────────
# 默认只监听本机；仅在可信网络/反向代理后才改为 0.0.0.0（Docker Compose 已自行设置）
HOST=127.0.0.1
PORT=8787
CACHE_DIR=./cache
TRANSLATION_AGENT_STORAGE=./cache/worker-storage.db

# ── YouTube / yt-dlp 配置 ─────────────────────────────────────────────
# YouTube 提取策略：Android 客户端与 PO Token Provider
YTDLP_YOUTUBE_CLIENT=android,mweb
# 本地实际运行 provider 才填写；compose 自动配置内部地址
YTDLP_POT_PROVIDER_URL=

# 可选：Netscape 格式 YouTube Cookie 文件路径
# 如遇到 YouTube 挑战 IP，可导出浏览器 Cookie 保存为 ./cookies/youtube-cookies.txt 并填入路径
YTDLP_COOKIES_FILE=

# ── 缓存 TTL 与清理策略（秒，0 表示不基于时长过期） ──────────────────
CACHE_METADATA_TTL_SECONDS=86400
CACHE_JSON3_TTL_SECONDS=2592000
CACHE_CUES_TTL_SECONDS=0
CACHE_TRANSLATION_TTL_SECONDS=0
CACHE_WHISPER_TTL_SECONDS=0
CACHE_MAX_BYTES=5368709120
CACHE_MAINTENANCE_INTERVAL_SECONDS=86400

# ── 浏览器来源白名单 ───────────────────────────────────────────────────
# 仅允许这些 Origin 的浏览器请求（含 WebSocket）；其他网页一律 403，防止任意网页消耗 API 额度。
# 无 Origin 的非浏览器客户端（curl 等）不受影响。`scheme://*` 匹配该协议下任意扩展 ID。
# 可固定为自己的扩展 ID 以进一步收紧，如 chrome-extension://abcdefghijklmnopabcdefghijklmnop
# ALLOWED_ORIGINS=https://www.youtube.com,chrome-extension://*,moz-extension://*
