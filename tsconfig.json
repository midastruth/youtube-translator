{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"]
  },
  "include": ["server/**/*.ts", "worker/**/*.ts", "extension/src/**/*.ts", "features/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
