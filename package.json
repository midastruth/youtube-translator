{
  "name": "youtube-translator",
  "version": "0.3.0",
  "description": "YouTube subtitle ingestion, sentence segmentation, and durable translation agent",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --pretty false",
    "build": "tsx scripts/build.ts",
    "build:extension": "tsx scripts/build.ts --extension",
    "test": "npm run build && node --import ./scripts/register-typescript.ts --test tests/*.test.ts && npm run test:acceptance",
    "verify": "npm test && npm run test:property",
    "test:property": "node --import ./scripts/register-typescript.ts --test tests/properties/*.property.ts",
    "test:coverage": "npm run build && node --import ./scripts/register-typescript.ts --experimental-test-coverage --test-coverage-include='worker/**/*.ts' --test-coverage-include='minimal-extension/src/types.ts' --test-coverage-include='minimal-extension/src/subtitles.ts' --test-coverage-include='minimal-extension/src/stream-request.ts' --test-coverage-include='minimal-extension/src/subtitle-stream.ts' --test tests/*.test.ts",
    "test:unit": "npm run build && node --import ./scripts/register-typescript.ts --test tests/*.test.ts",
    "test:acceptance": "npm run build && MISE_BABASHKA_VERSION=1.13.225 bb scripts/acceptance.bb",
    "test:backend": "cd backend && uv run pytest",
    "worker": "npm run build && node dist/worker/server.js"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
