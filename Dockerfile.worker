FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY worker ./worker
RUN node --input-type=module -e "import {build} from 'esbuild'; import {readdirSync} from 'node:fs'; await build({entryPoints:readdirSync('worker').filter(f=>f.endsWith('.ts')).map(f=>'worker/'+f),outdir:'dist/worker',platform:'node',format:'esm',target:'node24'});"
RUN npm prune --omit=dev --ignore-scripts

FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
RUN mkdir -p /app/cache && chown node:node /app/cache
USER node
ENV TRANSLATION_AGENT_HOST=0.0.0.0
ENV TRANSLATION_AGENT_STORAGE=/app/cache/worker-storage.db
EXPOSE 8788
CMD ["node", "dist/worker/server.js"]
