{
  "manifest_version": 3,
  "name": "YouTube Subtitle Translator",
  "version": "1.0.3",
  "description": "YouTube 双语字幕翻译 — 后端版",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
